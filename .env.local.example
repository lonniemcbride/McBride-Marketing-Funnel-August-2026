# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings > API in the Supabase dashboard). .env.local is gitignored.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — no NEXT_PUBLIC_ prefix, never shipped to the browser.
# Used by src/lib/supabase/admin.ts (the /api/supplement, /api/survey/*,
# and /api/admin/invite-recruiter routes).
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile (dash.cloudflare.com -> Turnstile). One widget,
# hostnames: mcbride-international.vercel.app, mcbride-air-force.vercel.app,
# localhost.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis (upstash.com), REST API tab on the database page — not the
# redis:// connection string.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry (sentry.io), Next.js project's DSN.
NEXT_PUBLIC_SENTRY_DSN=
